<odoo>
	<record id="view_set_analytic_tag_wizard_form" model="ir.ui.view">
	    <field name="name">set.analytic.tag.wizard.form</field>
	    <field name="model">set.analytic.tag.wizard</field>
	    <field name="arch" type="xml">
	        <form string="Create Internal Users">
	            <group>
	                <field name="account_analytic_tag" />
	                <field name="account_move_ids" widget="many2many_tags"/>
	            </group>
	            <footer>
	                <button name="set_analytic_tag" string="Set Analytic Tag" type="object" class="btn-primary"/>
	                <button string="Cancel" class="btn-secondary" special="cancel"/>
	            </footer>
	        </form>
	    </field>
	</record>

    <record id="action_set_analytic_tag_wizard" model="ir.actions.act_window">
	    <field name="name">Set analytic tag</field>
	    <field name="res_model">set.analytic.tag.wizard</field>
	    <field name="view_mode">form</field>
	    <field name="target">new</field>
	    <field name="binding_model_id" ref="account.model_account_move"/>
	</record>
</odoo>