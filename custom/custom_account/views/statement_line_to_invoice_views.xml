<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_statement_line_to_invoice_form" model="ir.ui.view">
        <field name="name">statement.line.to.invoice.form</field>
        <field name="model">statement.line.to.invoice</field>
        <field name="arch" type="xml">
            <form string="Category">
                <header>
                    <button name="action_create_invoice" string="Create invoice" class="oe_highlight"
                            type="object" groups="account.group_account_invoice" invisible="state != 'draft'"/>
                    <button name="action_assign_partner" string="Assign partner" type="object"
                            groups="account.group_account_invoice" invisible="partner_id != False"/>
                     <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="True"/>
                            <field name="email"/>
                            <field name="partner_id"/>
                            <field name="product_id"/>
                            <field name="amount"/>
                        </group>
                        <group>
                            <field name="invoice_date"/>
                            <field name="bank_statement_line_id" readonly="True"/>
                            <field name="account_analytic_tag_id"/>
                            <field name="invoice_id" readonly="True"/>
                            <field name="error_msg" readonly="True"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_statement_line_to_invoice_tree" model="ir.ui.view">
        <field name="name">statement.line.to.invoice.tree</field>
        <field name="model">statement.line.to.invoice</field>
        <field name="arch" type="xml">
            <list string="Invoices">
                <field name="email"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="amount"/>
                <field name="invoice_date"/>
                <field name="account_analytic_tag_id"/>
                <field name="invoice_id"/>
                <field name="error_msg"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="action_statement_line_to_invoice_line" model="ir.actions.act_window">
        <field name="name">Statement line to invoice</field>
        <field name="res_model">statement.line.to.invoice</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_statement_line_to_invoice_tree"/>
        <!--<field name="search_view_id" ref="view_account_move_filter"/>-->
    </record>
    
    <menuitem
        id="menu_statement_line_to_invoice_line"
        action="action_statement_line_to_invoice_line"
        parent="account_usability.menu_accounting_bank_and_cash"
        sequence="16"
        groups="base.group_no_one"
    />
</odoo>