<odoo>
	<record id="view_move_form_mkp" model="ir.ui.view">
		<field name="name">account.move.form</field>
		<field name="model">account.move</field>
		<field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">   
            <field name="partner_shipping_id" position="before">
                <field name="is_mkp_event_invoice" />
                <field name="mkp_event_budget_id" option="nocreate" invisible="is_mkp_event_invoice == False"/>
                <field name="expense_tag_id" invisible="is_mkp_event_invoice == False" widget="selection"/>
            </field>
        </field>
    </record>

    <record id="action_move_out_invoice_mkp_event" model="ir.actions.act_window">
	    <field name="name">MKP Event Invoices</field>
	    <field name="res_model">account.move</field>
	    <field name="view_mode">list,kanban,form,activity</field>
	    <field name="view_id" ref="account.view_out_invoice_tree"/>
	    <field name="search_view_id" ref="account.view_account_invoice_filter"/>
	    <field name="domain">[('move_type', 'in', ['out_invoice', 'out_refund']), ('is_mkp_event_invoice', '=', True)]</field>
	    <field name="context">{'default_move_type': 'out_invoice', 'default_is_mkp_event_invoice': True}</field>
	    <field name="help" type="html">
	      <p class="o_view_nocontent_smiling_face">
	        Create a MKP Event Invoice
	      </p>
	    </field>
    </record>

    <record id="action_move_out_invoice_non_mkp_event" model="ir.actions.act_window">
        <field name="name">Invoices</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,kanban,form,activity</field>
        <field name="view_id" ref="account.view_out_invoice_tree"/>
        <field name="search_view_id" ref="account.view_account_invoice_filter"/>
        <field name="domain">[('move_type', 'in', ['out_invoice', 'out_refund']), ('is_mkp_event_invoice', '=', False)]</field>
        <field name="context">{'default_move_type': 'out_invoice', 'default_is_mkp_event_invoice': True}</field>
        <field name="help" type="html">
          <p class="o_view_nocontent_smiling_face">
            Create a MKP Event Invoice
          </p>
        </field>
    </record>

    <record id="action_move_in_invoice_mkp_event" model="ir.actions.act_window">
        <field name="name">MKP Event Bills</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,kanban,form,activity</field>
        <field name="view_id" ref="account.view_in_invoice_tree"/>
        <field name="search_view_id" ref="account.view_account_invoice_filter"/>
        <field name="domain">[('move_type', 'in', ['in_invoice', 'on_refund']), ('is_mkp_event_invoice', '=', True)]</field>
        <field name="context">{'default_move_type': 'in_invoice', 'default_is_mkp_event_invoice': True}</field>
        <field name="help" type="html">
          <p class="o_view_nocontent_smiling_face">
            Create a MKP Event Invoice
          </p>
        </field>
    </record>
</odoo>