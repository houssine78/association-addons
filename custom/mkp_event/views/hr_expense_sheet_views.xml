<odoo>
    <record id="view_hr_expense_sheet_form_mkp" model="ir.ui.view">
	    <field name="name">hr.expense.sheet.form.mkp</field>
	    <field name="model">hr.expense.sheet</field>
	    <field name="inherit_id" ref="hr_expense.view_hr_expense_sheet_form"/>
	    <field name="arch" type="xml">
	       <field name="user_id" position="before">
	           <field name="is_mkp_event_expense"/>
	           <field name="mkp_event_budget_id" option="nocreate"/>
	       </field>
	    </field>
    </record>

	<record id="action_hr_expense_sheet_mkp" model="ir.actions.act_window">
	    <field name="name">Expense sheet</field>
	    <field name="res_model">hr.expense.sheet</field>
	    <field name="view_mode">list,kanban,form,pivot,graph</field>
	    <field name="search_view_id" ref="hr_expense.hr_expense_sheet_view_search_with_panel"/>
	    <field name="domain">[]</field>
	    <field name="context">{
	               'searchpanel_default_state': ["draft", "submit", "approve", "post", "done"],
	               'default_is_mkp_event_expense': True
	           }
	    </field>
	    <field name="help" type="html">
	        <p class="o_view_nocontent_smiling_face">
	            No expense reports found. Let's create one!
	        </p><p>
	            Expense reports regroup all the expenses incurred during a specific event.
	        </p>
	    </field>
	</record>
</odoo>