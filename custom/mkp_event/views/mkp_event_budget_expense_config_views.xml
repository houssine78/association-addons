<odoo>
    <record id="mkp_event_budget_expense_config_tree" model="ir.ui.view">
        <field name="name">mkp.event.budget.expense.config.tree</field>
        <field name="model">mkp.event.budget.expense.config</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="expense_category"/>
                <field name="distribution_analytic_account_id" widget="many2many_tags"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="mkp_event_budget_expense_config_form" model="ir.ui.view">
        <field name="name">mkp.event.budget.expense.config.form</field>
        <field name="model">mkp.event.budget.expense.config</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <sheet>
	                <group>
	                    <group>
	                        <field name="name"/>
			                <field name="expense_category"/>
	                        <field name="distribution_analytic_account_id" widget="many2many_tags"  options="{'no_create': True}"/>
	                    </group>
	                    <group>
	                    </group>
	                </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mkp_event_budget_expense_config" model="ir.actions.act_window">
        <field name="name">MKP Event Budget Expense Configuration</field>
        <field name="res_model">mkp.event.budget.expense.config</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="mkp_event_budget_expense_config_tree"/>
        <field name="help" type="html">
          <p class="o_view_nocontent_smiling_face">
            Create a MKP event budget expense configuration
          </p>
        </field>
    </record>
</odoo>